# Статический подсайт palomatika.ru/chekhov — обслуживается Apache напрямую,
# минуя Laravel front-controller родительского приложения.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /chekhov/

    # Trailing slash для красивых ЧПУ /chekhov/matematika/ → matematika/index.html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.+)$ /chekhov/$1/ [R=301,L]

    # Если файл существует — отдать как есть (статика, картинки, PHP-эндпоинт)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Иначе — наш 404 (а не Laravel)
    ErrorDocument 404 /chekhov/404.html
</IfModule>

# Кэш для статических ассетов Astro (хешированные имена → можно надолго)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Запрет листинга директорий
Options -Indexes

# Скрыть служебные файлы
<FilesMatch "^(config\.php|config\.example\.php|\.env)$">
    Require all denied
</FilesMatch>
