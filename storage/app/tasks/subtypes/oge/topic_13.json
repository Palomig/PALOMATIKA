{
  "_comment": "Подтипы внутри кураторских групп темы 13.",
  "2": [
    {"title": "Произведение скобок", "match": "\\)\\("},
    {"title": "Неполное квадратное неравенство", "match": "x\\^2"},
    {"title": "Линейное неравенство", "match": "."}
  ],
  "3": [
    {"title": "С нестрогими знаками", "match": "leq|geq"},
    {"title": "Со строгими знаками", "match": "."}
  ],
  "5": [
    {"title": "Вынести x за скобки", "match": "x-x\\^2"},
    {"title": "Разность квадратов", "match": "."}
  ]
}
